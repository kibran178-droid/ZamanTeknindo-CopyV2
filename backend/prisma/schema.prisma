model UserFace {
  id Int @id @default(autoincrement())
  penggunaId Int @unique @map("pengguna_id")
  user Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  descriptors Json
  quality String @default("KIOSK")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_face")
}

model ManualAbsenRequest {
  id Int @id @default(autoincrement())
  penggunaId Int @map("pengguna_id")
  user Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  tipe String
  requestedAt DateTime @map("requested_at")
  fotoBukti String? @map("foto_bukti")
  alasan String?
  status String @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("manual_absen_request")
}